# Copie para .env na pasta flows/ (ver flows/.env.example — arquivo completo).

APPID=br.com.polygonus.mobile.amostra
BUILD_VERSION=5.53.90

LOGIN_PHJESUS=PHJESUS
LOGIN_ETMENEZES=ETMENEZES
LOGIN_ACMENEZES=ACMENEZES
SENHA=POLY1000

# Nome exibido no topo do app — usado para abrir menu → Perfil (valores com espaço exigem aspas no CLI)
NOME_PHJESUS=Pedro Jesus
# ETMENEZES (responsável): header lista os filhos no app amostra
NOME_ETMENEZES=Ana, Bruno, Davi
NOME_ACMENEZES=Ana

TURMA_ROTINA=Maternal II
TURMA_EF_4ANO=4A
TURMA_EM_3ANO=M3A2026
TURMA_MURAL=Maternal II
