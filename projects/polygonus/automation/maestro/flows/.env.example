# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

APPID=br.com.polygonus.mobile.amostra

# Credenciais
# PHJESUS = professor E coordenador (alterna na tela Perfil após o login)
# ETMENEZES = responsável (visualiza comunicados)
# ACMENEZES = ALUNO (Eliza Teixeira de Menezes) — não usar para envio como professor
LOGIN_PHJESUS=PHJESUS
LOGIN_ETMENEZES=ETMENEZES
LOGIN_ACMENEZES=ACMENEZES
SENHA=poly1000

# Nome exibido no topo do app (primeiro nome ou completo) — usado para abrir o menu → Perfil
NOME_PHJESUS=Pedro Jesus
NOME_ETMENEZES=Eliza
NOME_ACMENEZES=Eliza

# Contexto de teste
TURMA_TESTE=F6A
ALUNO_NOME=Eliza Teixeira de Menezes

# Fixtures (nomes exatos em maestro/fixtures/ após push no device)
FIXTURE_FOTO=Foto_1.jpeg
FIXTURE_VIDEO=Video_teste.mp4
FIXTURE_PDF=PDF TESTE.pdf
