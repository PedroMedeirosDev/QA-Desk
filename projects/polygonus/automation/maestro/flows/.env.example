# Copie este arquivo para .env e preencha com os valores reais.

# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).



APPID=br.com.polygonus.mobile.amostra



# Credenciais

# PHJESUS = professor E coordenador (alterna na tela Perfil após o login)

# ETMENEZES = responsável (visualiza comunicados) — home: nomes dos filhos

# ACMENEZES = aluno — home: só o nome da aluna

LOGIN_PHJESUS=PHJESUS

LOGIN_ETMENEZES=ETMENEZES

LOGIN_ACMENEZES=ACMENEZES

SENHA=sua_senha_aqui



# Nome exibido no topo do app — usado após login (extendedWaitUntil) e menu → Perfil

NOME_PHJESUS=Pedro Jesus

# ETMENEZES (responsável): header lista os filhos

NOME_ETMENEZES=Ana, Bruno, Davi

# ACMENEZES (aluno): header só o nome da aluna (não confundir com o "Ana" da lista de filhos)

NOME_ACMENEZES=Ana



# Contexto de teste

TURMA_TESTE=F6A

ALUNO_NOME=Ana



# Fixtures (nomes exatos em maestro/fixtures/ após push no device)

FIXTURE_FOTO=Foto_1.jpeg

FIXTURE_VIDEO=Video_teste.mp4

FIXTURE_PDF=PDF TESTE.pdf



# Coordenadas Mural — copie de coordenadas.env.example e preencha no Studio

