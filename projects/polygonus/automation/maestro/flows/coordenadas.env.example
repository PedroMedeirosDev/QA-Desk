# Coordenadas do Mural — preencha e copie para flows/.env
#
# Formato Maestro: "X%, Y%" (percentual da tela, emulador Medium_Phone)
# Resolução de referência: anote se usar outro AVD
#
# Como capturar: Maestro Studio → tap no elemento → copiar point,
# ou DevTools/layout inspector. Teste 1 tap antes de commitar.

# ── Barra de filtros (abaixo do nome, dentro do Mural) ───────────────────────
COORD_FILTRO_RECEBIDAS=
COORD_FILTRO_ENVIADOS=
COORD_FILTRO_PENDENTES=
COORD_FILTRO_APROVADAS=

# ── Lista — menu ⋮ do primeiro card visível (Enviados) ───────────────────────
# Ancorar no card "Teste Comunicado" visível; coordenada do ícone ⋮ à direita
COORD_MENU_TRES_PONTOS=

# ── BoomMenu (FAB + itens) ───────────────────────────────────────────────────
COORD_BOOM_FAB=86%, 88%
COORD_BOOM_AVISO=
COORD_BOOM_EVENTO=

# ── Composer (barra inferior) ────────────────────────────────────────────────
COORD_BOTAO_GALERIA=
COORD_BOTAO_ENQUETE=
COORD_BOTAO_ANEXO=
