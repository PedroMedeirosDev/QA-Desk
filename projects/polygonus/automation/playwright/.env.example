# Copie para .env (não commitado)

# URL base da amostra CQ (path /gestao é da app React)
PLAYWRIGHT_GESTAO_URL=https://amostra.polygonus.com.br:8443/web/react/gestao
PLAYWRIGHT_LOGIN=SUPPETER
PLAYWRIGHT_SENHA=poly1000
PLAYWRIGHT_UNIDADE=Colégio Demonstração

# Automação só na amostra CQ (:8443). Login = …/gestao/login
# Não use a amostra pública sem porta nem outras escolas (ex.: colegiocarmo).

# Opcional
# PLAYWRIGHT_ANIVERSARIANTE_NOME=Aniversariante
# PLAYWRIGHT_ANIVERSARIANTE_ANO=2014
# SKIP_ANIVERSARIANTE_DN=1
# PLAYWRIGHT_DN_GESTAO_URL=https://amostra.polygonus.com.br:8443/web/react/gestao
# PLAYWRIGHT_DN_LOGIN=SUPPETER
# PLAYWRIGHT_DN_SENHA=poly1000
# PLAYWRIGHT_CHROME_PROFILE=.auth/chrome-profile
# PLAYWRIGHT_CHROME_PROFILE_FICHA=.auth/pw-ficha
# PLAYWRIGHT_CHROME_PROFILE_COMUNICADOS=.auth/pw-comunicados
# Smoke app Flutter (Comunicação → Comunicados): amostra PRODUÇÃO (sem :8443).
# Override: COMUNICADOS_GESTAO_URL=https://amostra.polygonus.com.br/web/react/gestao
# Login: LOGIN_PHJESUS ou PLAYWRIGHT_LOGIN=PHJESUS
# Homologação: deixe COMUNICADOS_REQUIRE_A11Y desligado (passa com canvas Flutter).
# Gate estrito (flt-semantics-identifier): COMUNICADOS_REQUIRE_A11Y=1
# PLAYWRIGHT_FICHA_KEEP=1   # E2E/FICHA-30: não exclui o aluno (população)
# PLAYWRIGHT_HEADED=0       # headless
# Probe de sessão (legado/sessao-*-idle.spec.ts)
# PLAYWRIGHT_SESSAO_PROBE_MIN=30
# PLAYWRIGHT_SESSAO_PROBE_TICK_SEC=60
# PLAYWRIGHT_ALUNO_HIST=Ana Carolina Teixeira de Menezes
# PLAYWRIGHT_ALUNO_BUSCA=Ana Carolina
