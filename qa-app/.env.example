# QA_APP_PORT=3001
# QA_APP_HOST=0.0.0.0
# NODE_ENV=production

# Postgres (opcional). Sem DATABASE_URL a API usa JSON em data/projects/.
# Suba: cd qa-app && docker compose up -d
# Depois: npx prisma migrate deploy && npm run db:migrate-json
# Porta 5433 = container Docker (compose). Evita conflito com Postgres nativo na 5432.
DATABASE_URL=postgresql://qa:qa@127.0.0.1:5433/qa_app?schema=public

# Habilita botão "Executar automação" (Maestro no PC local — emulador ligado)
QA_AUTOMATION_RUN=1

# AVD do Android Studio (Device Manager) — default: Medium_Phone
# QA_ANDROID_AVD=Medium_Phone

# Antes do Play: se adb não tiver device, liga o emulador automaticamente (boot ~1–2 min)
# QA_ANDROID_AUTO_EMULATOR=1

# Webhook N8N pós-run Maestro (opcional — ver projects/polygonus/automation/n8n/README.md)
# Suba: cd projects/polygonus/automation/n8n && docker compose up -d
N8N_WEBHOOK_URL=http://localhost:5678/webhook/maestro-run
