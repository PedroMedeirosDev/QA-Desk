# QA_APP_PORT=3001
# Local: 0.0.0.0 · Produção (atrás do Caddy): 127.0.0.1 (default se NODE_ENV=production)
# QA_APP_HOST=0.0.0.0
# Local: NODE_ENV=development (ou omita). production só na VM / start:prod —
# senão o `npm run dev` sobe a API servindo dist/ antigo junto com o Vite.

# CORS — origens permitidas (vírgula). Em prod, deixe vazio = só same-origin via Caddy.
# Dev sem variável = reflete qualquer origem (Vite).
# QA_CORS_ORIGINS=https://qa-desk-pedro.duckdns.org
# Rate limits (opcional)
# QA_RATE_LIMIT_API=400
# QA_RATE_LIMIT_WEBHOOK=60

# Postgres (opcional). Sem DATABASE_URL a API usa JSON em data/projects/.
# Suba: cd qa-desk && docker compose up -d
# Depois: npx prisma migrate deploy && npm run db:migrate-json
# Porta 5433 = container Docker (compose). Evita conflito com Postgres nativo na 5432.
# Em cloud: use a URI do Postgres do Supabase (pooler :6543 recomendado).
DATABASE_URL=postgresql://qa:qa@127.0.0.1:5433/qa_app?schema=public
# Obrigatório se o schema Prisma tiver directUrl (local = mesma URL; Supabase = porta 5432):
DIRECT_URL=postgresql://qa:qa@127.0.0.1:5433/qa_app?schema=public

# --- Supabase Auth (opcional em dev local) ---
# Sem VITE_SUPABASE_URL o app roda em modo mock (admin local, sem tela de login).
# Front (Vite — só URL + anon key):
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# Server (mesma URL/anon; service_role NUNCA no Vite):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # obrigatório p/ Storage (evidence + avatars) e seed

# Storage: rode supabase/migrations/004_storage_buckets.sql no SQL Editor.
# Depois (opcional): npm run storage:seed-avatar

# Login rápido "Acessar como visitante" (aparece no bundle do front — conta demo só)
# VITE_VISITOR_EMAIL=visitante@qa-desk.local
# VITE_VISITOR_PASSWORD=

# Habilita botão "Executar automação" (Maestro no PC local — emulador ligado)
# Em cloud / Oracle / Koyeb: deixe 0 ou omita.
QA_AUTOMATION_RUN=1

# Agente remoto (PC atende jobs da API online). Mesmo token no servidor e no `npm run agent`.
# QA_AGENT_TOKEN=
# QA_DESK_URL=https://qa-desk-pedro.duckdns.org

# AVD do Android Studio (Device Manager) — default: Medium_Phone
# QA_ANDROID_AVD=Medium_Phone

# Antes do Play: se adb não tiver device, liga o emulador automaticamente (boot ~1–2 min)
# QA_ANDROID_AUTO_EMULATOR=1

# Webhook N8N pós-run Maestro (opcional — ver projects/polygonus/automation/n8n/README.md)
# Suba: cd projects/polygonus/automation/n8n && docker compose up -d
# Discord — bot (recomendado): envio + reação ✅ → corrigido_gestor
# Portal: https://discord.com/developers/applications → Bot → token
# Intents: Server Members opcional; precisa Guild Messages + Message Content NÃO obrigatório
# Convite: scopes bot; Send Messages + Attach Files + Add Reactions + Read Message History + Manage Messages
# DISCORD_BOT_TOKEN=
# DISCORD_BUG_CHANNEL_ID=  # snowflake do canal (ativar modo desenvolvedor no Discord → copiar ID)
# DISCORD_GESTOR_USER_IDS=  # opcional: só estes users contam no ✅ (csv)
# Fallback webhook (só envio; sem reação se o bot não estiver rodando):
# DISCORD_BUG_WEBHOOK_URL=https://discord.com/api/webhooks/...

N8N_WEBHOOK_URL=http://localhost:5678/webhook/maestro-run

# --- Curadoria KB: webhook GitHub (status em tempo quase real) ---
# Crie um webhook no repo polygonus-suporte-kb:
#   Payload URL: https://<host-do-qa-desk>/api/webhooks/github/kb-curation
#   Content type: application/json
#   Secret: o mesmo valor abaixo
#   Events: Pull requests + Pull request reviews + Issues + Issue comments + Issue dependencies
# Ver: server/github/README.md
# GITHUB_WEBHOOK_SECRET=troque-por-um-segredo-longo
# GITHUB_WEBHOOK_DEBOUNCE_MS=1500
# Issues de bug (volta closed → Desk): autor/assignee permitidos (default PedroMedeirosDev)
# GITHUB_BUG_ISSUE_ACTORS=PedroMedeirosDev
# Comentários na issue: quem conta como gestor (vazio = qualquer login fora dos atores QA)
# GITHUB_BUG_COMMENT_ACTORS=
# Issues de bug (handoff QA → KB): default polygonus-br/polygonus-suporte-kb
# GITHUB_BUG_ISSUES_REPO=polygonus-br/polygonus-suporte-kb

# --- Suite API Newman (Polygonus CQ / Ficha Acadêmica) ---
# Automação só no CQ. Gestão CQ:
#   https://amostra.polygonus.com.br:8443/web/react/gestao/login
# Host CQ = até :8443 (remove /web/react/...); API = host + /api/v2
# POLY_API_BASE_URL=https://amostra.polygonus.com.br:8443/api/v2
# POLY_API_LOGIN=SUPPETER
# POLY_API_SENHA=  # mesma do PHJESUS; ou use PLAYWRIGHT_SENHA
# POLY_API_UNIDADE=Colégio Demonstração
# POLY_API_HOSTNAME=amostra.polygonus.com.br
# POLY_API_ANO=2026
# PLAYWRIGHT_SENHA=  # fallback se POLY_API_SENHA vazio
