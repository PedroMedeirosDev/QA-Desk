# QA_APP_PORT=3001
# QA_APP_HOST=0.0.0.0
# Local: NODE_ENV=development (ou omita). production só na VM / start:prod —
# senão o `npm run dev` sobe a API servindo dist/ antigo junto com o Vite.

# Postgres (opcional). Sem DATABASE_URL a API usa JSON em data/projects/.
# Suba: cd qa-desk && docker compose up -d
# Depois: npx prisma migrate deploy && npm run db:migrate-json
# Porta 5433 = container Docker (compose). Evita conflito com Postgres nativo na 5432.
# Em cloud: use a URI do Postgres do Supabase (pooler :6543 recomendado).
DATABASE_URL=postgresql://qa:qa@127.0.0.1:5433/qa_app?schema=public
# Obrigatório se o schema Prisma tiver directUrl (local = mesma URL; Supabase = porta 5432):
DIRECT_URL=postgresql://qa:qa@127.0.0.1:5433/qa_app?schema=public

# --- Supabase Auth (opcional em dev local) ---
# Sem VITE_SUPABASE_URL o app roda em modo mock (admin local, sem tela de login).
# Front (Vite — só URL + anon key):
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# Server (mesma URL/anon; service_role NUNCA no Vite):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Habilita botão "Executar automação" (Maestro no PC local — emulador ligado)
# Em cloud / Oracle / Koyeb: deixe 0 ou omita.
QA_AUTOMATION_RUN=1

# AVD do Android Studio (Device Manager) — default: Medium_Phone
# QA_ANDROID_AVD=Medium_Phone

# Antes do Play: se adb não tiver device, liga o emulador automaticamente (boot ~1–2 min)
# QA_ANDROID_AUTO_EMULATOR=1

# Webhook N8N pós-run Maestro (opcional — ver projects/polygonus/automation/n8n/README.md)
# Suba: cd projects/polygonus/automation/n8n && docker compose up -d
N8N_WEBHOOK_URL=http://localhost:5678/webhook/maestro-run
