# Copie para .env (local) ou .env na VM Oracle — NÃO cole secrets reais neste arquivo.
# Build Vite embute VITE_* — preencha ANTES de `npm run build`.
# Guia: deploy/SUPABASE_CREDENTIALS.md

# Só na VM / deploy. No PC com `npm run dev`, use development (ver .env.example).
NODE_ENV=production
QA_APP_PORT=3001
QA_APP_HOST=0.0.0.0

# Maestro NÃO roda na cloud
# QA_AUTOMATION_RUN=0

# --- Supabase Auth ---
# Publishable (sb_publishable_…) OU legado anon (eyJ…)
VITE_SUPABASE_URL=https://SEU_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Postgres — botão Connect no topo do projeto ---
# DATABASE_URL = Transaction pooler (:6543)
# DIRECT_URL   = Session pooler (:5432 no host pooler) — evite Direct IPv6 na VM Oracle free
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public
DIRECT_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public
