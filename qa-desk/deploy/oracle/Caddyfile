# Substitua qa-desk.seudominio.com pelo seu domínio (DuckDNS, Cloudflare, etc.)
# Caddy obtém certificado Let's Encrypt automaticamente.

qa-desk.seudominio.com {
	# SSE / NDJSON: sem gzip (bufferiza) e flush imediato
	@sse path_regexp sse ^/api/(projects/[^/]+/kb-curation/stream|projects/[^/]+/tests/[^/]+/github-issue(/sync)?|bugs/gestor-replies/stream)$
	handle @sse {
		reverse_proxy 127.0.0.1:3001 {
			flush_interval -1
		}
	}

	handle {
		encode gzip
		reverse_proxy 127.0.0.1:3001
	}
}
