{
  "name": "qa-desk",
  "private": true,
  "version": "0.1.0",
  "description": "QA Desk — homologação e registro de testes multi-projeto",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -r -n api,ui -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "start:prod": "npm run build && npm run start",
    "lint": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate-json": "tsx server/scripts/migrate-json-to-pg.ts",
    "postinstall": "prisma generate",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "e2e:headed": "playwright test -c e2e/playwright.config.ts --headed",
    "e2e:api": "cross-env DATABASE_URL= QA_APP_PORT=3011 QA_AUTOMATION_RUN=0 QA_E2E_MOCK=1 tsx server/index.ts",
    "e2e:ui-server": "cross-env QA_APP_PORT=3011 QA_VITE_API_TARGET=http://127.0.0.1:3011 vite --mode e2e --host 127.0.0.1 --port 5175 --strictPort"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.110.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.511.0",
    "multer": "^1.4.5-lts.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "^3.3.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/helmet": "^0.0.48",
    "@types/multer": "^1.4.12",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "prisma": "^6.12.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
