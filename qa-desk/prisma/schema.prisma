generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Projeto QA (polygonus | anihype)
model Project {
  slug        String   @id
  label       String
  metaVersion String   @default("1.0.0") @map("meta_version")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tests         Test[]
  homologations Homologation[]
  runs          TestRun[]

  @@map("projects")
}

/// CT / bug — payload JSON = TestRecord completo; colunas indexadas para filtros
model Test {
  id                 String   @id
  projectSlug        String   @map("project_slug")
  testKey            String?  @map("test_key")
  recordType         String   @default("teste") @map("record_type")
  title              String
  status             String
  homologationStatus String?  @map("homologation_status")
  homologationId     String?  @map("homologation_id")
  campaign           String?
  payload            Json
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  project Project   @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  runs    TestRun[]

  @@unique([projectSlug, testKey])
  @@index([projectSlug])
  @@index([homologationId])
  @@index([campaign])
  @@map("tests")
}

model Homologation {
  id          String   @id
  projectSlug String   @map("project_slug")
  slug        String
  title       String
  status      String
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)

  @@unique([projectSlug, slug])
  @@index([projectSlug])
  @@map("homologations")
}

/// Histórico de execuções Maestro/Playwright (além do lastRun embutido no Test)
model TestRun {
  id             String   @id @default(uuid())
  projectSlug    String   @map("project_slug")
  testId         String   @map("test_id")
  runId          String   @unique @map("run_id")
  runNumber      Int?     @map("run_number")
  status         String
  exitCode       Int?     @map("exit_code")
  flowPath       String?  @map("flow_path")
  output         String?  @db.Text
  appVersion     String?  @map("app_version")
  homologationId String?  @map("homologation_id")
  startedAt      DateTime @map("started_at")
  finishedAt     DateTime @default(now()) @map("finished_at")
  meta           Json?
  evidencePaths  Json?    @map("evidence_paths")

  project Project @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([projectSlug, testId])
  @@index([homologationId])
  @@index([startedAt])
  @@map("test_runs")
}
